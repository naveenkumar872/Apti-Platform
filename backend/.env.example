# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/aptitude_platform
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aptitude_platform
DB_USER=postgres
DB_PASSWORD=yourpassword

# JWT
JWT_ACCESS_SECRET=your_access_token_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_refresh_token_secret_here_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@aptitude-platform.com

# Redis (optional for MVP, for sessions and rate limiting)
REDIS_URL=redis://localhost:6379

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173

# AI/LLM API
OPENAI_API_KEY=your_openai_api_key
